{
  "name": "fuga",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:acceptance && npm run test:non-functional",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:debug": "PLAYWRIGHT_VISUAL_DEBUG=true playwright test tests/e2e --project=chromium --headed --debug",
    "test:e2e:ui": "PLAYWRIGHT_VISUAL_DEBUG=true playwright test tests/e2e --project=chromium --ui",
    "test:acceptance": "playwright test tests/acceptance",
    "test:acceptance:debug": "PLAYWRIGHT_VISUAL_DEBUG=true playwright test tests/acceptance --project=chromium --headed --debug",
    "test:acceptance:ui": "PLAYWRIGHT_VISUAL_DEBUG=true playwright test tests/acceptance --project=chromium --ui",
    "test:non-functional": "playwright test tests/non-functional",
    "test:non-functional:debug": "PLAYWRIGHT_VISUAL_DEBUG=true playwright test tests/non-functional --project=chromium --headed --debug",
    "test:non-functional:ui": "PLAYWRIGHT_VISUAL_DEBUG=true playwright test tests/non-functional --project=chromium --ui",
    "test:playwright:debug": "PLAYWRIGHT_VISUAL_DEBUG=true playwright test --project=chromium --headed --debug",
    "test:playwright:ui": "PLAYWRIGHT_VISUAL_DEBUG=true playwright test --project=chromium --ui",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.453.0",
    "next": "^15.3.2",
    "next-auth": "^5.0.0-beta.25",
    "pg": "^8.14.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.53.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prisma": "^7.0.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
